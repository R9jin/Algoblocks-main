import ast
import uuid

def gen_uid():
    return str(uuid.uuid4())[:15]

class BlocklyASTConverter:
    def convert(self, code: str):
        try:
            tree = ast.parse(code)
            first_block = self.serialize_body(tree.body)
            if first_block:
                first_block["x"] = 20
                first_block["y"] = 20
                return {"blocks": {"languageVersion": 0, "blocks": [first_block]}}
            return {"blocks": {"languageVersion": 0, "blocks": []}}
        except Exception as e:
            print("AST Parsing Error:", e)
            return None

    def serialize_body(self, nodes):
        if not nodes:
            return None
        
        first_block = None
        prev_block = None
        
        for node in nodes:
            block = self.serialize_node(node)
            
            # THE GATEKEEPER: Fallback to Raw Statement if unsupported
            if not block:
                try:
                    code_str = ast.unparse(node)
                except:
                    continue
                block = {
                    "type": "raw_python_statement",
                    "id": gen_uid(),
                    "fields": {"CODE": code_str}
                }
                
            if not first_block:
                first_block = block
            else:
                prev_block["next"] = {"block": block}
            prev_block = block
            
        return first_block

    def serialize_node(self, node):
        try:
            # 1. Standard Variable Assignments (e.g., step = math.sqrt(n))
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                return {
                    "type": "variables_set",
                    "id": gen_uid(),
                    "fields": {"VAR": {"id": node.targets[0].id, "name": node.targets[0].id}},
                    "inputs": {
                        "VALUE": {
                            "block": {
                                "type": "raw_python_expression",
                                "id": gen_uid(),
                                "fields": {"CODE": ast.unparse(node.value)}
                            }
                        }
                    }
                }
            
            # 2. Augmented Assignments (e.g., prev += 1)
            elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):
                op_map = {
                    ast.Add: "ADD", ast.Sub: "MINUS", 
                    ast.Mult: "MULTIPLY", ast.Div: "DIVIDE"
                }
                op_type = type(node.op)
                if op_type in op_map:
                    return {
                        "type": "math_assignment",
                        "id": gen_uid(),
                        "fields": {
                            "VAR": {"id": node.target.id, "name": node.target.id},
                            "OP": op_map[op_type]
                        },
                        "inputs": {
                            "DELTA": {
                                "block": {
                                    "type": "raw_python_expression",
                                    "id": gen_uid(),
                                    "fields": {"CODE": ast.unparse(node.value)}
                                }
                            }
                        }
                    }

            # 3. While Loops
            elif isinstance(node, ast.While):
                block = {
                    "type": "controls_whileUntil",
                    "id": gen_uid(),
                    "fields": {"MODE": "WHILE"},
                    "inputs": {
                        "BOOL": {
                            "block": {
                                "type": "raw_python_expression",
                                "id": gen_uid(),
                                "fields": {"CODE": ast.unparse(node.test)}
                            }
                        }
                    }
                }
                body_block = self.serialize_body(node.body)
                if body_block:
                    block["inputs"]["DO"] = {"block": body_block}
                return block
                
            # 4. If Statements
            elif isinstance(node, ast.If):
                block = {
                    "type": "controls_if",
                    "id": gen_uid(),
                    "inputs": {
                        "IF0": {
                            "block": {
                                 "type": "raw_python_expression",
                                 "id": gen_uid(),
                                 "fields": {"CODE": ast.unparse(node.test)}
                            }
                        }
                    }
                }
                body_block = self.serialize_body(node.body)
                if body_block:
                    block["inputs"]["DO0"] = {"block": body_block}
                    
                if node.orelse:
                    block["extraState"] = {"hasElse": True}
                    else_body = self.serialize_body(node.orelse)
                    if else_body:
                        block["inputs"]["ELSE"] = {"block": else_body}
                return block

            # 5. Returns (e.g., return prev)
            elif isinstance(node, ast.Return):
                val_code = ast.unparse(node.value) if node.value else "None"
                return {
                    "type": "procedure_return_value",
                    "id": gen_uid(),
                    "inputs": {
                        "VALUE": {
                            "block": {
                                "type": "raw_python_expression",
                                "id": gen_uid(),
                                "fields": {"CODE": val_code}
                            }
                        }
                    }
                }

            # 6. Function Definitions
            elif isinstance(node, ast.FunctionDef):
                block = {
                    "type": "procedures_defnoreturn",
                    "id": gen_uid(),
                    "fields": {"NAME": node.name},
                }
                if node.args.args:
                    block["extraState"] = {
                        "params": [{"name": arg.arg, "id": arg.arg} for arg in node.args.args]
                    }
                body_block = self.serialize_body(node.body)
                if body_block:
                    block["inputs"]["STACK"] = {"block": body_block}
                return block
            
            # 7. Print Statements
            elif isinstance(node, ast.Expr) and isinstance(node.value, ast.Call) and isinstance(node.value.func, ast.Name) and node.value.func.id == 'print':
                # Join arguments back into a string for the raw block
                args_code = ", ".join(ast.unparse(arg) for arg in node.value.args)
                return {
                    "type": "text_print",
                    "id": gen_uid(),
                    "inputs": {
                        "TEXT": {
                            "block": {
                                "type": "raw_python_expression",
                                "id": gen_uid(),
                                "fields": {"CODE": args_code}
                            }
                        }
                    }
                }

        except Exception as e:
            pass # Suppress inner errors, let Gatekeeper handle it
            
        return None